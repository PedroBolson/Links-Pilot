# Chave da Google Safe Browsing API — armazenada no Secret Manager do Firebase, não neste arquivo.
# Para configurar: firebase functions:secrets:set SAFE_BROWSING_API_KEY
# Obter chave em: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
# GOOGLE_SAFE_BROWSING_API_KEY=

# Usado pelas Cloud Functions para montar a URL curta retornada ao cliente.
# Configure no ambiente das Functions se usar domínio customizado.
# HOSTING_URL=https://seu-dominio.com.br
