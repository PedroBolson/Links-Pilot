rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Nenhum acesso por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // Links — leitura apenas pelo dono, escrita só via Admin SDK (Cloud Functions)
    match /links/{linkId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // Slugs — consulta pontual por usuários autenticados, escrita só via Admin SDK
    match /slugs/{slug} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if false;
    }

    // Perfil de usuário — leitura apenas pelo próprio usuário, escrita só via Admin SDK
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Cliques — leitura apenas pelo dono do link, escrita só via Admin SDK
    match /clicks/{clickId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // Config pública de produto/preço — escrita só pelo servidor ou Console
    match /billingPlans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // Uso/cobrança — usuário só lê seus próprios ciclos e eventos
    match /billingCycles/{cycleId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /usageEvents/{eventId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }
  }
}
